      "maxDuration": 300,
      "excludeFiles": "{tests/**,docs/**,tools/**,.github/**,Dockerfile*,render.yaml,ROADMAP.md}"
    }
  },
  "crons": [
    {
      "path": "/v1/schedule/daily",
