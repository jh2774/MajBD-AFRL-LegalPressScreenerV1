# Copy to .env. Every value is optional; the tool degrades rather than fails.

# --- REQUIRED IN PRACTICE ---------------------------------------------------
# SEC and other .gov endpoints block generic agents. Use a real contact address.
FOCI_USER_AGENT=foci-screen/0.1 (you@yourorg.gov)

# --- OPTIONAL API KEYS ------------------------------------------------------
# SAM.gov entity registration + solicitation points of contact.
#   free at https://sam.gov -> Account Details -> Request Public API Key
SAM_API_KEY=

# USPTO Open Data Portal. Without it, recorded IP security interests are NOT
# checked, and the screen will say so rather than implying none exist.
#   free at https://developer.uspto.gov
USPTO_API_KEY=

# Without a USPTO key: the index built by `foci-screen import-patent-assignments`
# from the USPTO Patent Assignment Dataset (a yearly research release, so liens
# recorded after its last date are not seen). Default: patent_assignments.db
# FOCI_PATENT_ASSIGNMENTS=patent_assignments.db

# Trade.gov Consolidated Screening List (BIS Entity List, DDTC, OFAC combined).
TRADE_GOV_API_KEY=

# --- STORAGE ----------------------------------------------------------------
FOCI_DB=foci_screen.db
FOCI_CACHE=.cache
FOCI_OUT=out

# Postgres. Set this and FOCI_DB is ignored. Required for any deployment with
# more than one process or an ephemeral disk. Render injects it automatically.
DATABASE_URL=

# Or, on Google Cloud, Cloud SQL's separate values (used when DATABASE_URL is
# empty). Only the password is a secret. See docs/GOOGLE_CLOUD.md.
INSTANCE_CONNECTION_NAME=
DB_USER=
DB_NAME=
DB_PASS=

# Size cap for the HTTP cache in FOCI_CACHE, in megabytes. Defaults to 256, or
# 64 on Cloud Run, where files in the container are held in memory.
FOCI_CACHE_MAX_MB=

# --- SERVICE MODE (API + worker) --------------------------------------------
# Without Redis, screens run in a background thread and die with the process.
# That is fine for a laptop and wrong for a deployment.
REDIS_URL=
FOCI_JOB_TIMEOUT=3600

# While a screen runs in the web process, hold a request open against the
# service itself so the host neither starves it (Cloud Run) nor shuts the
# instance down as idle (Cloud Run, Render's free plan). Leave unset: it is on
# wherever a managed host is detected. false turns it off.
FOCI_KEEP_AWAKE=

# API keys as "tenant:key" pairs, comma separated. With this empty the API
# refuses every authenticated request — it fails closed deliberately.
#   FOCI_API_KEYS=acme:sk_live_9f3c...,navy-pmo:sk_live_1a7b...
FOCI_API_KEYS=
# Comma-separated origins for a browser client. Empty disables CORS entirely.
FOCI_CORS_ORIGINS=

# --- HEADLESS BROWSER -------------------------------------------------------
# Investor-relations subdomains are JavaScript applications that drop
# non-browser clients. Without this the screen cannot read them and says so.
#   pip install -e ".[browser]" && playwright install chromium
FOCI_BROWSER=true
FOCI_BROWSER_TIMEOUT=25

# --- HTTP -------------------------------------------------------------------
FOCI_TIMEOUT=45
FOCI_QPS=3.0
FOCI_CACHE_TTL=21600
FOCI_RETRIES=3

# --- STEP 3: EMAIL ----------------------------------------------------------
# All three guards below are OFF by default. With no changes, notices are
# written to ./out as .eml files and nothing is transmitted.

# Guard 1: master switch for the Gmail path.
GMAIL_ENABLED=false

# Guard 2: send rather than draft. Leave false. Drafts let a human read each
# notice before it reaches a contracting officer.
GMAIL_SEND=false

GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json
GMAIL_SENDER=

# Guard 3: safety valve. While set, EVERY notice goes here instead of to the
# KO. Set this to your own address for the whole of your first live pilot.
# It governs portfolio alerts (below) as well.
FOCI_EMAIL_REDIRECT_TO=

# --- PORTFOLIO EMAIL ALERTS --------------------------------------------------
# Alerts to the addresses typed into a portfolio. Separate from the notices
# above. Connecting a mail service here is what turns sending on; with none,
# alerts are written and shown in the app but nothing is sent.
# DEPLOY.md, "Turning on email alerts", has the steps.

# Over HTTPS. The route that works on Render's free plan, which blocks the
# SMTP ports (25, 465, 587). Set one key, and the address alerts come from.
BREVO_API_KEY=
RESEND_API_KEY=
ALERTS_FROM=

# Or plain SMTP (a paid instance, or port 2525 where the relay offers it).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls

# brevo | resend | smtp. Only needed if more than one of the above is set.
MAIL_PROVIDER=

# Leave unset to send whenever a service is connected. false holds every alert
# as a draft; true reports a missing service as a fault.
ALERTS_SEND=

# Where links in an alert point, e.g. https://contractwatcher-4wxb.onrender.com
FOCI_PUBLIC_URL=
